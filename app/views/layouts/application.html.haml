!!!
%html{ lang: 'ja' }
  %head
    %meta{ charset: 'UTF-8' }/
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }/
    %title= [title.presence, '漫トロピーWeb'].compact.join(' - ')

    / Bootstrap 5.3.3 / Bootstrap Icons 1.11.3 (CDN)
    %link{ rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', integrity: 'sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH', crossorigin: 'anonymous' }/
    %link{ rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css' }/
    %script{ src: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js', integrity: 'sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz', crossorigin: 'anonymous', defer: true }

    = csrf_meta_tag
    = stylesheet_link_tag 'application', 'style', media: 'all'
    = javascript_importmap_tags
    = yield :header
  %body
    / グローバルナビゲーション
    %nav.navbar.navbar-expand-lg.bg-body-tertiary.border-bottom.shadow-sm
      .container
        = link_to root_path, class: 'navbar-brand d-flex align-items-center gap-2' do
          = image_tag 'logo.png', width: 164, alt: '漫トロピーWebロゴ', class: 'img-fluid'
        %button.navbar-toggler{ type: 'button', data: { 'bs-toggle' => 'collapse', 'bs-target' => '#globalNav' }, aria: { controls: 'globalNav', expanded: 'false', label: 'ナビゲーションを開閉' } }
          %span.navbar-toggler-icon
        #globalNav.collapse.navbar-collapse
          %ul.navbar-nav.me-auto.mb-2.mb-lg-0
            %li.nav-item
              - if current_user
                = link_to 'メンバートップ', member_root_path, class: 'nav-link'
              - else
                = link_to 'トップ', root_path, class: 'nav-link'
            %li.nav-item= link_to '漫トロピーについて', wiki_path('about'), class: 'nav-link'
            %li.nav-item= link_to 'メンバー', users_path, class: 'nav-link'
            %li.nav-item= link_to 'ランキング', rankings_path, class: 'nav-link'
            %li.nav-item= link_to '活動ブログ', 'http://mantropy.hatenablog.com/', class: 'nav-link'
          %ul.navbar-nav.ms-auto.mb-2.mb-lg-0
            %li.nav-item
              - if current_user
                = link_to 'ログアウト', destroy_userauth_session_path, method: :delete, class: 'nav-link'
              - elsif current_userauth
                = link_to 'ユーザー細部登録', new_member_user_path, class: 'nav-link'
              - else
                = link_to 'ログイン', [:new, :userauth_session], class: 'nav-link'

    / 検索フォーム
    .bg-body-secondary.border-bottom.py-3
      .container
        = form_tag(series_path, { method: :get }) do
          .row.g-2.align-items-center
            .col-12.col-lg-8
              .input-group
                = text_field_tag :str, @str, class: 'form-control', title: '漫トロピーWeb検索', placeholder: '漫トロピーWeb検索'
                = submit_tag '検索', class: 'btn btn-primary', name: nil
          .row
            .col-12.mt-1
              - if current_user
                .form-check.form-check-inline
                  = radio_button_tag :scope, 'rakuten', true, class: 'form-check-input'
                  = label_tag :scope_rakuten, 'Rakutenから検索', class: 'form-check-label'
              - else
                .form-check.form-check-inline
                  = radio_button_tag :scope, 'mantropy', true, class: 'form-check-input'
                  = label_tag :scope_mantropy, 'ぎも゛ぢいぃ゛いぃ゛ぃ', class: 'form-check-label'
              .form-check.form-check-inline
                = radio_button_tag :scope, 'mantropy', false, class: 'form-check-input', id: 'scope_mantropy_web'
                = label_tag :scope_mantropy_web, '漫トロWebから検索', class: 'form-check-label'

    / ページタイトルバー
    .bg-body-tertiary.border-bottom
      .container.d-flex.flex-wrap.justify-content-between.align-items-center.py-2
        %span.fw-bold= title
        %span.small.text-body-secondary
          - if current_user
            おはようございます、
            %b>= current_user.name
            さん
          - else
            ウレピー！

    .container.my-4
      - if notice.present?
        .alert.alert-info.alert-dismissible.fade.show{ role: 'alert' }
          = notice
          %button.btn-close{ type: 'button', data: { 'bs-dismiss' => 'alert' }, aria: { label: '閉じる' } }
      - if alert.present?
        .alert.alert-danger.alert-dismissible.fade.show{ role: 'alert' }
          = alert
          %button.btn-close{ type: 'button', data: { 'bs-dismiss' => 'alert' }, aria: { label: '閉じる' } }
      = yield

    %footer.border-top.py-3.mt-5
      .container.text-center
        %small.text-body-secondary
          \&copy;
          = link_to '京大漫トロピー', root_path, target: '_blank', class: 'link-secondary'
