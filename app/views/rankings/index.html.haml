%h2.h3.my-4 漫画ランキング一覧

.card.shadow-sm.mb-4
  .list-group.list-group-flush
    - @rankings.each do |ranking|
      - if !ranking.is_registerable? || current_user.present?
        = link_to ranking_series_path(ranking.name), class: 'list-group-item list-group-item-action d-flex align-items-center gap-2' do
          %i.bi.bi-globe2.text-primary
          = ranking.name
      - else
        .list-group-item.d-flex.align-items-center.gap-2.text-body-secondary
          %i.bi.bi-lock
          = ranking.name
          %span.badge.text-bg-secondary.ms-auto 登録作業中
