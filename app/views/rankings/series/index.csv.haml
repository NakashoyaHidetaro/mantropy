順位,合計得点,糞補正後得点,ランキング重複数,糞重複数,コメント数,serie_id,name,漫画家,雑誌,ranks
- @series.each do |serie|
  = "#{serie.rank_info[:rank]},#{serie.rank_info[:sum_of_mark]},#{serie.rank_info[:sum_of_mark_with_kuso]},#{serie.rank_info[:count_rank]},#{serie.rank_info[:count_kuso]},#{serie.rank_info[:count_post]},#{serie.id},#{serie.name},#{serie.authors.map{|a| a.name}.join("　")},#{serie.magazines.map{|m| m.name}.uniq.join("　")},#{RankAggregation.sort_ranks(serie.ranks.where(:ranking_id => @ranking_ids)).map{|r| "#{r.user.name} (#{r.ranking_id == @ranking_ids.last ? "糞" : nil}#{r.rank}位)"}.join("　")}"
