- content_for :title, '全体ランキング'

-# 同年度の各 kind のランキング。該当 kind が無い年度でも nil 安全に扱う
- kojin_ranking = @rankings_by_kind['kojin']
- kuso_ranking = @rankings_by_kind['kuso']
- zentai_ranking = @rankings_by_kind['zentai']
- zentaikuso_ranking = @rankings_by_kind['zentaikuso']
-# 投票者リストに出す元票のランキング（個人・糞）
- vote_ranking_ids = [kojin_ranking&.id, kuso_ranking&.id].compact
- count = 0
- if @series
  .vstack.gap-3.my-3
    - @series.each do |serie|
      - kojin_ranks = kojin_ranking ? serie.ranks.where(:ranking_id => kojin_ranking.id).to_a : []
      - is_mine = current_user && kojin_ranks.map { |r| r.user_id }.include?(current_user.id)
      - zentai_rank = zentai_ranking && serie.ranks.where(:ranking_id => zentai_ranking.id).first
      - zentaikuso_rank = zentaikuso_ranking && serie.ranks.where(:ranking_id => zentaikuso_ranking.id).first
      .card.shadow-sm
        - if is_mine
          .card-header.bg-info-subtle.text-info-emphasis.fw-bold
            %i.bi.bi-check2-circle.me-1
            ランキングへ入れています
        .card-body
          .d-flex.flex-wrap.gap-2.mb-3.small
            %span.badge.text-bg-primary 順位: #{zentai_rank&.rank}
            %span.badge.text-bg-secondary 得点（重複修正）: #{zentai_rank&.score}
            %span.badge.text-bg-secondary 重複数: #{kojin_ranks.size}
            %span.badge.text-bg-secondary 糞修正順位: #{zentaikuso_rank&.rank}
            %span.badge.text-bg-secondary 糞修正得点: #{zentaikuso_rank&.score}
          .d-flex.gap-3
            - if (count += 1) <= SerieRanking::IMAGE_RANK_LIMIT
              .flex-shrink-0
                = link_to serie, { target: "_blank" } do
                  = image_tag serie_image_path(serie), alt: serie.name, class: 'img-fluid rounded'
            .flex-grow-1
              %h5.mb-1= link_to serie.name, serie, { target: "_blank" }
              %p.text-body-secondary.small.mb-2
                = serie.authors.map { |a| a.name }.join('、')
                - if serie.magazines.select("DISTINCT *").any?
                  %span.mx-1 /
                  = serie.magazines.select("DISTINCT *").map { |m| m.name }.join('、')
              .d-flex.flex-wrap.gap-2
                -# 個人票を先に、次に糞票を並べ、それぞれの中では順位順
                - serie.ranks.where(:ranking_id => vote_ranking_ids).sort_by { |r| [r.ranking_id == kuso_ranking&.id ? 1 : 0, r.rank] }.each do |r|
                  = link_to "#{r.user.name} (#{r.ranking_id == kuso_ranking&.id ? '糞' : nil}#{r.rank}位)", user_path(r.user.name), class: 'link-secondary small'

= paginate @series
