- content_for :title, 'パスワードの変更'
.row.justify-content-center
  .col-md-6.col-lg-5
    .card.shadow-sm.my-4
      .card-body.p-4
        %h2.h4.card-title.text-center.mb-4
          %i.bi.bi-shield-lock.me-2
          パスワードの変更
        = form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :put }) do |f|
          = render "devise/shared/devise_error_messages"
          = f.hidden_field :reset_password_token
          = required_legend
          .mb-3
            = required_label f, :password, "新しいパスワード"
            = f.password_field :password, class: "form-control", autocomplete: "new-password"
          .mb-3
            = required_label f, :password_confirmation, "新しいパスワード(確認)"
            = f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password"
          .d-grid
            = f.submit "パスワードを変更する", class: "btn btn-primary w-100"
        = render :partial => "devise/shared/links"
