- content_for :title, 'パスワードを忘れた'
.row.justify-content-center
  .col-md-6.col-lg-5
    .card.shadow-sm.my-4
      .card-body.p-4
        %h2.h4.card-title.text-center.mb-4
          %i.bi.bi-key.me-2
          パスワードを忘れた
        = form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post }) do |f|
          = render "devise/shared/devise_error_messages"
          = required_legend
          .mb-3
            = required_label f, :email, "メールアドレス"
            = f.email_field :email, class: "form-control", autocomplete: "email"
          .d-grid
            = f.submit "パスワード再設定の手順をメールで送信する", class: "btn btn-primary w-100"
        = render :partial => "devise/shared/links"
