.row.justify-content-center
  .col-md-6.col-lg-5
    .card.shadow-sm.my-4
      .card-body.p-4
        %h2.h4.card-title.text-center.mb-4
          %i.bi.bi-key.me-2
          パスワードを忘れた
        = form_for(resource, :as => resource_name, :url => password_path(resource_name), :html => { :method => :post }) do |f|
          = render "devise/shared/devise_error_messages"
          .mb-3
            = f.label "メールアドレス", class: "form-label"
            = f.email_field :email, class: "form-control", autocomplete: "email"
          .d-grid
            = f.submit "私にパスワードをリセットするための手順をメールで送ってよ", class: "btn btn-primary w-100"
        = render :partial => "devise/shared/links"
