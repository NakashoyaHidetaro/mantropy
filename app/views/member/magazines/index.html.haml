%h1 雑誌一覧
%table.table
  %thead
    %tr
      %th 雑誌名
      %th 出版社
      %th 掲載シリーズ（一部）
  %tbody
    - @magazines.each do |magazine|
      %tr
        %td= magazine.name
        %td= magazine.publisher
        %td
          - magazine.series.select('DISTINCT *').limit(4).each do |serie|
            = link_to serie.name, serie_path(serie)
