- content_for :title, 'メンバーページ'
%h2.text-center.mt-4 メンバーページ
.list-group.mt-2
  = link_to user_path(current_user.name), class: 'list-group-item list-group-item-action' do
    %i.bi.bi-person
    = current_user.name
    のユーザーページ
  = link_to member_topics_path, class: 'list-group-item list-group-item-action' do
    %i.bi.bi-pencil-square
    内部掲示板
  = link_to member_posts_path, class: 'list-group-item list-group-item-action' do
    %i.bi.bi-chat-dots
    ポストタイムライン
  = link_to member_wikis_path, class: 'list-group-item list-group-item-action' do
    %i.bi.bi-file-earmark-text
    Wikiページ一覧
  = link_to member_rankings_path, class: 'list-group-item list-group-item-action' do
    %i.bi.bi-list-stars
    ランキングカテゴリ一覧変更
  = link_to member_site_configs_path, class: 'list-group-item list-group-item-action' do
    %i.bi.bi-gear-fill
    mantropy.net グローバル設定変更

%h3.mt-4.text-center 集計データ
.list-group.mt-2
  - @rankings.each do |ranking|
    .list-group-item.d-flex.flex-wrap.align-items-center.gap-2
      %i.bi.bi-list-ol
      = link_to ranking.name, ranking_series_path(ranking.name)
      = link_to '集計ページ', aggregated_ranking_series_path(ranking.name), class: 'badge text-bg-secondary text-decoration-none'
      = link_to 'CSV', ranking_series_path(ranking.name, format: :csv), class: 'badge text-bg-light border text-decoration-none'
      = link_to 'JSON', ranking_series_path(ranking.name, format: :json), class: 'badge text-bg-light border text-decoration-none'
      = link_to 'XML', ranking_series_path(ranking.name, format: :xml), class: 'badge text-bg-light border text-decoration-none'
  .list-group-item.d-flex.flex-wrap.align-items-center.gap-2
    %i.bi.bi-people
    = link_to '全メンバー順位一覧', users_path
    = link_to 'CSV', users_path(format: :csv), class: 'badge text-bg-light border text-decoration-none'
    = link_to 'JSON', users_path(format: :json), class: 'badge text-bg-light border text-decoration-none'

%h3.mt-4.text-center 外部リソース
.list-group.mt-2
  = link_to 'http://wiki.livedoor.jp/mantropy/', target: '_blank', class: 'list-group-item list-group-item-action' do
    %i.bi.bi-file-earmark-text
    旧Wiki
  = link_to 'http://skydrive.live.com/', target: '_blank', class: 'list-group-item list-group-item-action' do
    %i.bi.bi-cloud-arrow-down
    SkyDrive

%h3.mt-4.text-center お知らせWiki
= render 'wikis/show'
