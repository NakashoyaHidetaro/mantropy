= form_for([:member, @topic]) do |f|
  = render 'shared/error_messages', record: @topic
  .mb-3
    = f.label :title, class: 'form-label'
    = f.text_field :title, class: 'form-control'
  .mb-3
    = f.label :appear, class: 'form-label'
    = f.text_field :appear, class: 'form-control'
  .mt-2
    = f.submit class: 'btn btn-primary'
