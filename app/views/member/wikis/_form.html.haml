= form_for([:member, @wiki]) do |f|
  - if @wiki.errors.any?
    #error_explanation.alert.alert-danger
      %h2.h6
        = pluralize(@wiki.errors.count, "error")
        prohibited this wiki from being saved:
      %ul.mb-0
        - @wiki.errors.full_messages.each do |msg|
          %li= msg
  .mb-3
    = f.label "ページ名", class: 'form-label'
    = f.text_field :name, :readonly => (@wiki.name.present? ? true : false), class: 'form-control'
  .mb-3
    = f.label "タイトル", class: 'form-label'
    = f.text_field :title, class: 'form-control'
  .mb-3
    = f.label "内容", class: 'form-label'
    = f.text_area :content, class: 'form-control font-monospace', rows: 15
  .mb-3.form-check
    = f.check_box :is_private, class: 'form-check-input'
    = f.label "公開は内部のみ", class: 'form-check-label'
  .mb-3
    = f.submit class: 'btn btn-primary'
.card.mt-4
  .card-body
    = raw HikiDoc.to_html(@notation)
