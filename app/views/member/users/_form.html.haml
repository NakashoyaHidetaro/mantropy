= form_for([:member, @user]) do |f|
  - if @user.errors.any?
    #error_explanation.alert.alert-danger
      %h2.h6
        = pluralize(@user.errors.count, "error")
        prohibited this post from being saved:
      %ul.mb-0
        - @user.errors.full_messages.each do |msg|
          %li= msg
  .row
    .col-md-6.mb-3
      = f.label "ペンネーム", class: 'form-label'
      = f.text_field :name, class: 'form-control'
    .col-md-6.mb-3
      = f.label "本名", class: 'form-label'
      = f.text_field :realname, class: 'form-control'
    .col-md-6.mb-3
      = f.label "パソコンメール", class: 'form-label'
      = f.email_field :pcmail, class: 'form-control'
    .col-md-6.mb-3
      = f.label "携帯メール", class: 'form-label'
      = f.email_field :mbmail, class: 'form-control'
    .col-md-6.mb-3
      = f.label "Twitterアカウント", class: 'form-label'
      = f.text_field :twitter, class: 'form-control'
    .col-md-6.mb-3
      = f.label "外部Webサイト", class: 'form-label'
      = f.text_field :url, class: 'form-control'
  .mb-3
    = f.label "外部向けAbout", class: 'form-label'
    = f.text_area :publicabout, :rows => 4, class: 'form-control'
  .mb-3
    = f.label "内部向けAbout", class: 'form-label'
    = f.text_area :privateabout, :rows => 4, class: 'form-control'
  .row
    .col-md-6.mb-3
      = f.label "入トロ年度", class: 'form-label'
      = f.text_field :joined, class: 'form-control'
    .col-md-6.mb-3
      = f.label "入学年度", class: 'form-label'
      = f.text_field :entered, class: 'form-control'
  .mt-2
    = f.submit class: 'btn btn-primary'
