= form_for([:member, @user]) do |f|
  = render 'shared/error_messages', record: @user
  = required_legend
  .row
    .col-md-6.mb-3
      = required_label(f, :name, 'ペンネーム')
      = f.text_field :name, class: 'form-control'
    .col-md-6.mb-3
      = required_label(f, :realname, '本名')
      = f.text_field :realname, class: 'form-control'
    .col-md-6.mb-3
      = f.label :pcmail, 'パソコンメール', class: 'form-label'
      = f.email_field :pcmail, class: 'form-control'
    .col-md-6.mb-3
      = required_label(f, :mbmail, '携帯メール')
      = f.email_field :mbmail, class: 'form-control'
    .col-md-6.mb-3
      = f.label :twitter, 'Twitterアカウント', class: 'form-label'
      = f.text_field :twitter, class: 'form-control'
    .col-md-6.mb-3
      = f.label :url, '外部Webサイト', class: 'form-label'
      = f.text_field :url, class: 'form-control'
  .mb-3
    = f.label :publicabout, '外部向けAbout', class: 'form-label'
    = f.text_area :publicabout, :rows => 4, class: 'form-control'
  .mb-3
    = f.label :privateabout, '内部向けAbout', class: 'form-label'
    = f.text_area :privateabout, :rows => 4, class: 'form-control'
  .row
    .col-md-6.mb-3
      = required_label(f, :joined, '入トロ年度')
      = f.text_field :joined, class: 'form-control'
    .col-md-6.mb-3
      = required_label(f, :entered, '入学年度')
      = f.text_field :entered, class: 'form-control'
  .mt-2
    = f.submit class: 'btn btn-primary'
