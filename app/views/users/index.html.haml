- content_for :title, 'メンバー一覧'

- if @downloadable
  .my-3.d-flex.flex-wrap.gap-2
    = link_to users_path(format: :csv), download: true, class: 'btn btn-outline-secondary btn-sm' do
      %i.bi.bi-download.me-1
      メンバー一覧をCSVでダウンロードする
    = link_to users_path(format: :json), download: true, class: 'btn btn-outline-secondary btn-sm' do
      %i.bi.bi-download.me-1
      メンバー一覧をJSONでダウンロードする

- if current_user
  %h2.h4.mb-3 ランキング提出状況
  .list-group.mb-4
    - @users.each do |user|
      .list-group-item.d-flex.flex-wrap.align-items-center.gap-2
        = link_to user.name, user_path(user.name), class: 'fw-bold text-decoration-none'
        - @registering_rankings.each do |ranking|
          - unless complete_ranking(ranking, user)
            %span.d-inline-flex.align-items-center.gap-1
              %span.badge.text-bg-warning= ranking.name + '不十分'
              %span.text-muted.small
                提出数
                %span.fw-bold= user.ranks.where(:ranking_id => ranking.id).count

%h2.h4.mb-3 現在の漫トロを構成する者たち
.row.row-cols-2.row-cols-md-4.g-3
  = render partial: 'users/user_card', collection: @users, as: :user

-# 旧メンバーはゲスト含む全員に見せる（休会会員が自分の既存アカウントに気付けるようにするため）。ただし既定では折りたたむ
%h2.h4.mt-5.mb-2 かつて漫トロを創りし者たち
%p.text-muted.mb-2
  ログイン情報は生きてます。休会・退会された方のアカウントも削除せず残しています。
  再開される方は新しくアカウントを作らず、管理者にご連絡ください。
.d-flex.flex-wrap.align-items-center.gap-2
  %button.btn.btn-sm.btn-outline-secondary.old-users-toggle{type: :button, data: { 'bs-toggle' => 'collapse', 'bs-target' => '#old-users-collapse' }, aria: { expanded: 'false', controls: 'old-users-collapse' }}
    %i.bi.bi-plus-lg
    %i.bi.bi-dash-lg
    %span.ms-1 もっと見る
  %span.text-muted.small= "#{@old_users.size}人"
.collapse.old-users-collapse.mt-2#old-users-collapse
  .row.row-cols-2.row-cols-md-4.g-3
    = render partial: 'users/user_card', collection: @old_users, as: :user
